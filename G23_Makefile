# G23_Makefile

IMAGE_NAME   = electra-sim:v1
CLUSTER_NAME = llm-cluster
NUM_TRIALS   = 5
RESULTS_DIR  = results
DELAY_MS     = 10
FOLDER       = results

.PHONY: build run-affinity run-antiaffinity run-affinity-trials run-antiaffinity-trials \
        run-all-trials plot plot-folder sweep sweep-w4 sweep-summary sweep-plot phase-plot \
        clean setup-results netem-apply netem-clear netem-status

setup-results:
	@mkdir -p $(RESULTS_DIR)

build:
	docker build -f G23_Dockerfile -t $(IMAGE_NAME) .
	kind load docker-image $(IMAGE_NAME) --name $(CLUSTER_NAME)

# ── Single-run (2-pod) ──
run-affinity: setup-results
	kubectl apply -f G23_k8s_affinity.yaml
	kubectl wait --for=jsonpath='{.status.phase}'=Succeeded pod/electra-master --timeout=600s
	kubectl logs electra-master
	kubectl logs electra-master | sed -n '/===CSV_START===/,/===CSV_END===/p' | grep -v '===CSV' > $(RESULTS_DIR)/G23_results_affinity.csv
	kubectl delete -f G23_k8s_affinity.yaml

run-antiaffinity: setup-results
	kubectl apply -f G23_k8s_antiaffinity.yaml
	kubectl wait --for=jsonpath='{.status.phase}'=Succeeded pod/electra-master --timeout=600s
	kubectl logs electra-master
	kubectl logs electra-master | sed -n '/===CSV_START===/,/===CSV_END===/p' | grep -v '===CSV' > $(RESULTS_DIR)/G23_results_antiaffinity.csv
	kubectl delete -f G23_k8s_antiaffinity.yaml

# ── Full sweeps ──
sweep:
	@bash G23_sweep_run.sh

sweep-w4:
	@bash G23_sweep_run_w4.sh

# ── Analysis ──
sweep-summary:
	python G23_sweep_summary.py

sweep-plot:
	python G23_sweep_plot.py

phase-plot:
	python G23_phase_plot.py

plot-folder:
	python G23_plot.py $(FOLDER)

# ── Network latency (tc netem) ──
netem-apply:
	@bash G23_netem_apply.sh $(DELAY_MS)

netem-clear:
	@bash G23_netem_clear.sh

netem-status:
	@bash G23_netem_status.sh

# ── Cleanup ──
clean:
	kubectl delete -f G23_k8s_affinity.yaml --ignore-not-found
	kubectl delete -f G23_k8s_antiaffinity.yaml --ignore-not-found
	kubectl delete -f G23_k8s_affinity_w4.yaml --ignore-not-found
	kubectl delete -f G23_k8s_antiaffinity_w4.yaml --ignore-not-found
