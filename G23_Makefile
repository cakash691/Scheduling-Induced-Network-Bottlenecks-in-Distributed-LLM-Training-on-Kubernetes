# G23_Makefile

IMAGE_NAME = electra-sim:v1
CLUSTER_NAME = llm-cluster

.PHONY: build run-affinity run-antiaffinity plot clean

# 1. Builds the Docker image and loads it into the kind cluster
build:
	@echo " Building Docker image..."
	docker build -f G23_Dockerfile -t $(IMAGE_NAME) .
	@echo " Loading image into kind cluster..."
	kind load docker-image $(IMAGE_NAME) --name $(CLUSTER_NAME)
	@echo " Build and load complete!"

# 2. Runs the Same-Node experiment, fetches logs, and cleans up
run-affinity:
	@echo " Starting Affinity Experiment (Same Node)..."
	kubectl apply -f G23_k8s_affinity.yaml
	@echo " Waiting 5 seconds for pods to initialize..."
	sleep 5
	@echo " Fetching Logs..."
	kubectl logs electra-master -f
	@echo " Cleaning up Affinity pods..."
	kubectl delete -f G23_k8s_affinity.yaml
	@echo " Affinity experiment finished!"

# 3. Runs the Cross-Node experiment, fetches logs, and cleans up
run-antiaffinity:
	@echo " Starting Anti-Affinity Experiment (Different Nodes)..."
	kubectl apply -f G23_k8s_antiaffinity.yaml
	@echo " Waiting 5 seconds for pods to initialize..."
	sleep 5
	@echo " Fetching Logs..."
	kubectl logs electra-master -f
	@echo " Cleaning up Anti-Affinity pods..."
	kubectl delete -f G23_k8s_antiaffinity.yaml
	@echo " Anti-Affinity experiment finished!"

# 4. Generates the final plot
plot:
	@echo " Generating plot..."
	python G23_plot.py

# 5. Emergency cleanup just in case pods get stuck
clean:
	@echo " Force cleaning all project pods..."
	kubectl delete -f G23_k8s_affinity.yaml --ignore-not-found
	kubectl delete -f G23_k8s_antiaffinity.yaml --ignore-not-found
